{
  "name": "@sfu-engine/client",
  "version": "0.1.0",
  "description": "Browser SDK for the SFU engine: join rooms, publish camera, microphone and screen, receive others.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean && tsc -p tsconfig.build.json"
  },
  "license": "UNLICENSED"
}
